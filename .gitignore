# Project specific
config.cfg
master_inventory.xml
owner.zip
get_children_parent_4235.txt

# Temporary data and logs  
tmp/
*.log
*.json
# tests/_oracle_outputs holds JSON snapshots that *are* committed (byte-equality
# oracles for the composer migration; see tests/fixtures/README.md).
!tests/_oracle_outputs/*.json
# ...and the site-log oracle's snapshots, which are RENDERED SITE LOGS and so
# carry the published `.log` extension the blanket rule above excludes. Without
# this negation the snapshots are silently uncommittable and the oracle fails on
# a fresh clone with "Snapshot missing" — a gate that never guards anything.
!tests/_oracle_outputs/sitelog/*.log
# ...and the station-history oracle's captured terminal output (`*.txt` is not
# ignored, but keep the two oracle snapshot dirs listed together).
!tests/_oracle_outputs/station_history/*.txt
*.D
*.D.Z

# Reference data (downloaded on demand)
reference_data/
data/station_config/station.info.sopac.apr05
# Safe-update system runtime artifacts (timestamped backups + working copies of station.info)
data/station_config/backups/
data/station_config/work/

